export component WipeCenter inherits VerticalLayout {
    in-out property <string> result;
    callback refresh() -> string;
    callback append-log(string);

    spacing: 8px;
    Text { text: "Wipe"; font-size: 22px; font-weight: 700; color: #e8eaf0; }
    Text { text: "Wipe plan preview (read-only, userdata only). Type WIPE then YES on a live fastboot device only; backup is required first."; font-size: 12px; color: #8a90a3; wrap: word-wrap; }
    HorizontalLayout {
        spacing: 8px;
        Button {
            text: "Refresh";
            clicked => {
                result = refresh();
                append-log("wipe-center refresh");
            }
        }
    }
    TextEdit {
        text <=> result;
        read-only: true;
        font-size: 12px;
        vertical-stretch: 1;
    }
    Text { text: "Typed-confirm display: type WIPE (1/2) then type YES (2/2). Fallback is stock eRecovery (Vol-Up 3s) wipe on the phone."; font-size: 12px; color: #8a90a3; wrap: word-wrap; }
}
