import { Button, TextEdit } from "std-widgets.slint";

export component RootCenter inherits VerticalLayout {
    in-out property <string> result;
    callback refresh() -> string;
    callback append-log(string);

    spacing: 8px;
    Text { text: "Root Status"; font-size: 22px; font-weight: 700; color: #e8eaf0; }
    Text { text: "Current state plus honesty badge (read-only). EXPERIMENTAL until hardware POC; never shown as Ready."; font-size: 12px; color: #8a90a3; wrap: word-wrap; }
    HorizontalLayout {
        spacing: 8px;
        Button {
            text: "Refresh";
            clicked => {
                result = refresh();
                append-log("root-center refresh");
            }
        }
    }
    TextEdit {
        text <=> result;
        read-only: true;
        font-size: 12px;
        vertical-stretch: 1;
    }
}

