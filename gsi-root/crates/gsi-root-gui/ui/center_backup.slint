import { Button, TextEdit } from "std-widgets.slint";

export component BackupCenter inherits Rectangle {
    in-out property <string> result;
    callback refresh() -> string;
    callback append-log(string);

    VerticalLayout {
        spacing: 8px;
        Text {
            text: "Backup";
            font-size: 22px;
            font-weight: 700;
            color: #e8eaf0;
        }
        Text {
            text: "Saved backups by model and date with verified states and hashes (read-only). Device dump needs a live device.";
            font-size: 12px;
            color: #8a90a3;
            wrap: word-wrap;
        }
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: "Refresh";
                clicked => {
                    result = refresh();
                    append-log("backup-center refresh");
                }
            }
        }
        TextEdit {
            text <=> result;
            read-only: true;
            font-size: 12px;
            vertical-stretch: 1;
        }
    }
}

